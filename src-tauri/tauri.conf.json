{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mikui - Kafka UI",
  "mainBinaryName": "Mikui - Kafka UI",
  "version": "0.1.0",
  "identifier": "com.nahua.mikui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mikui - Kafka UI",
        "width": 800,
        "height": 600,
        "backgroundColor": "#0f172b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mikui"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
